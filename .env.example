DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_portal
DB_USER=root
DB_PASS=

# "local" shows PHP errors on screen. Use anything else in production.
APP_ENV=local

# Absolute base URL, used for links inside emails. Leave blank to derive it
# from the current request (fine on localhost).
APP_URL=http://localhost/JobPortal

# Outgoing mail (application confirmations and status updates).
# For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_ENCRYPTION=tls

MAIL_FROM=you@gmail.com
MAIL_FROM_NAME="JobPortal"
