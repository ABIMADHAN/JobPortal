# Deny direct access to config/secret files at the project root.
<FilesMatch "\.(env|sql|md)$">
    Require all denied
</FilesMatch>

# Shared includes are never meant to be requested directly.
<FilesMatch "^(config|db|functions|auth|header|footer|site-nav|site-footer)\.php$">
    Require all denied
</FilesMatch>

DirectoryIndex index.php
Options -Indexes
